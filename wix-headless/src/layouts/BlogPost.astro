---
import Layout from './Layout.astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  samples?: boolean;
  title: string;
  description?: string;
  pubDate: Date;
  heroImage?: string;
  tags?: Array<{ label: string; slug: string }>;
}
const { title, description = '', pubDate, heroImage, tags = [], samples = false } = Astro.props;
---
<Layout title={title} description={description} hasSeoTags>
  <Fragment slot="head"><BaseHead title={`${title} · phrits.com`} description={description} image={heroImage} />{samples && <meta name="robots" content="noindex, nofollow" />}</Fragment>
  <article>
    <header class="post-hero">
      <div class="max-w-6xl mx-auto px-lg py-3xl">
        <a href={samples ? '/blog?samples=1' : '/blog'} class="eyebrow back-link">Notes</a>
        <div class="post-heading">
          <h1>{title}</h1>
          <p class="post-date"><FormattedDate date={pubDate} /></p>
        </div>
      </div>
    </header>
    {heroImage && <div class="hero-image max-w-6xl mx-auto px-lg"><img src={heroImage} width="1280" height="640" alt="" /></div>}
    <div class="post-body container-reading px-lg py-3xl">
      {tags.length > 0 && <div class="tags flex flex-wrap gap-xs">{tags.map((tag) => <a href={`/blog?${samples ? 'samples=1&' : ''}topic=${encodeURIComponent(tag.slug)}`}>{tag.label}</a>)}</div>}
      <slot />
    </div>
  </article>
</Layout>
<style is:global>
  .post-hero { background: var(--color-navy); color: var(--color-paper); border-bottom: 1.15rem solid var(--color-accent); }
  .back-link { display: inline-block; margin-bottom: var(--spacing-xl); color: var(--color-paper-warm); }
  .post-heading { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--spacing-xl); }
  .post-heading h1 { max-width: 17ch; font-size: clamp(3.4rem, 8vw, 8rem); letter-spacing: -.045em; }
  .post-date { font-family: var(--font-mono); font-size: .78rem; }
  .hero-image { margin-top: var(--spacing-2xl); }
  .hero-image img { width: 100%; max-height: 38rem; object-fit: cover; }
  .tags { margin-bottom: var(--spacing-lg); }
  .tags a { padding: .25rem .5rem; border: 1px solid var(--color-rule); font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; }
  .ricos-content, .ricos-content p, .ricos-content li, .ricos-content h1, .ricos-content h2, .ricos-content h3, .ricos-content h4, .ricos-content blockquote { color: var(--color-ink) !important; }
  .ricos-content { font-family: var(--font-body); font-size: 1.13rem; line-height: 1.75; }
  .ricos-content h2, .ricos-content h3, .ricos-content h4 { font-family: var(--font-display); margin-block: 1.75em .65em; }
  .ricos-content p, .ricos-content ul, .ricos-content ol, .ricos-content blockquote { margin-block: 1em; }
  .ricos-content a { color: var(--color-accent) !important; text-decoration: underline; text-decoration-thickness: .12em; text-underline-offset: .16em; }
  @media (max-width: 767px) { .post-heading { grid-template-columns: 1fr; } }
</style>
