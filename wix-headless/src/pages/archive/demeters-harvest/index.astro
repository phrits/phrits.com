---
import Layout from '../../../layouts/Layout.astro';
import items from '../../../data/archive-items.json';
import '../../../styles/archive-content.css';
const entries=items.filter(i=>i.slug.startsWith('demeters-harvest/') && !/chapter_index|recipe_index|cookbook\.html|index\.html/.test(i.sourcePath || '')); 
const sections=[...new Set(entries.map(i=>i.section))];
---
<Layout title="Demeter’s Harvest (Archive)"><div class="archive-reading"><nav><a href="/archive/">← Archive</a></nav><article class="legacy-content"><header class="collection-heading"><p class="collection-label">Historical collection · Pagan/Wiccan material</p><h1>Demeter’s Harvest</h1><p class="collection-subtitle">The Witches Against Religious Discrimination Cookbook</p></header><aside class="context-note" aria-labelledby="context-heading"><h2 id="context-heading">Before you browse</h2><p>This is an archived Pagan/Wiccan collection created for Witches Against Religious Discrimination (W.A.R.D.) and once distributed on CD as a fundraiser. It includes recipes alongside material on ritual, aromatherapy, correspondences, crafts, and natural health and home care.</p><p>The collection reflects the time it was assembled. Its language, links, and practices are preserved as historical material.</p></aside><nav class="chapter-nav" aria-label="Cookbook chapters"><h2>Browse the collection</h2><ul>{sections.map((s,i)=><li><a href={`#chapter-${i}`}>{s.replace('Demeter’s Harvest · ','')}</a></li>)}</ul></nav>{sections.map((s,i)=><section id={`chapter-${i}`}><h2>{s.replace('Demeter’s Harvest · ','')}</h2><ul>{entries.filter(e=>e.section===s).map(e=><li><a href={`/archive/item/?slug=${encodeURIComponent(e.slug)}`}>{e.title}</a></li>)}</ul></section>)}</article></div></Layout>
<style>
.collection-heading{padding:1.5rem 0 1rem;border-bottom:7px solid #08087a}.collection-label{font-family:var(--font-mono);font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#9b0000}.collection-heading h1{font-size:clamp(2.5rem,6vw,4.5rem);margin:.5rem 0;color:#08087a}.collection-subtitle{font-size:1.25rem;font-weight:700}.context-note{margin:1.5rem 0;padding:1.25rem;border-left:8px solid #9b0000;background:#fff8e8}.context-note h2,.chapter-nav h2{margin:0 0 .75rem;color:#08087a;font-size:1.65rem}.context-note p+p{margin-top:.65rem}.chapter-nav{margin:2rem 0;padding:1rem;border-top:5px solid #f2c53d;border-bottom:1px solid #cbbeac}.chapter-nav ul{columns:2;column-gap:2rem}.chapter-nav li{break-inside:avoid}@media(max-width:600px){.chapter-nav ul{columns:1}}
</style>
