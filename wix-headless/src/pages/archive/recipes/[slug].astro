---
import Layout from '../../../layouts/Layout.astro';
import recipes from '../../../data/archive-recipes.json';
const slug = Astro.params.slug;
if (slug === 'quickle-pickle') return Astro.redirect('/archive/recipes/quickle/', 301);
const recipe = recipes.find(item => item.slug === slug);
if (!recipe) return Astro.redirect('/archive/recipes/', 302);
const tagLabel = (tag: string) => `#${tag}${/^adaptable/i.test(recipe.dietaryNote || '') || new RegExp(`adapted to ${tag}`, 'i').test(recipe.dietaryNote || '') ? ' (adaptable)' : ''}`;
---
<Layout title={recipe.title} description={recipe.description || `${recipe.title}, from the phrits.com recipe archive.`}>
  <div class="recipe-page">
    <nav class="recipe-nav" aria-label="Recipe navigation"><a href="/archive/recipes/">← All recipes</a><a href="/archive">The archive</a></nav>
    <p class="eyebrow">From the old kitchen</p>
    {recipe.tags.length > 0 && <div class="tags" aria-label="Recipe tags">{recipe.tags.map(tag => <a href={`/archive/recipes/?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}</div>}
    {recipe.dietaryNote && <p class="dietary-note">{recipe.dietaryNote.replace(/\s+,/g, ',')}</p>}
    {recipe.slug === 'sugarplums' && <figure class="photo-strip"><img src="/archive-legacy/images/sugarplums.jpg" alt="Homemade sugarplums" /></figure>}
    <article class="legacy-recipe" set:html={recipe.html} />
    <footer class="recipe-end"><a href="/archive/recipes/">← Back to the recipe collection</a></footer>
  </div>
</Layout>
<style>
.recipe-page{--red:#9b0000;--blue:#08087a;--cream:#fff9eb;max-width:960px;margin:auto;padding:1.5rem 1.5rem 3rem;color:#191919}.recipe-nav{display:flex;justify-content:space-between;gap:1rem;border-bottom:6px solid var(--blue);padding-bottom:.8rem;font-weight:700;font-family:var(--font-mono);font-size:.9rem;color:var(--blue)}.recipe-nav a,.recipe-end a{text-decoration:underline;text-underline-offset:4px}.eyebrow{font-family:var(--font-mono);font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--red);font-weight:700;margin:1.1rem 0 .4rem}.tags{display:flex;gap:.7rem;flex-wrap:wrap;font-family:var(--font-mono);font-size:.85rem;color:var(--blue);margin:.5rem 0}.tags a{text-decoration:underline;text-underline-offset:3px}.dietary-note{font-size:.85rem;color:#45413d;margin:.4rem 0 .8rem}.photo-strip{margin:.8rem 0}.photo-strip img{width:100%;height:160px;object-fit:cover;object-position:center}.legacy-recipe{font-size:1.1rem;line-height:1.55;overflow-wrap:break-word}.legacy-recipe :global(.wrapper){padding:0;background:none;color:inherit}.legacy-recipe :global(h1){color:var(--blue);font-size:clamp(2.4rem,6vw,3.6rem);line-height:1.05;margin:.5rem 0 1rem;letter-spacing:-.035em}.legacy-recipe :global(h2){font-size:1.55rem;line-height:1.2;color:var(--red);border-top:3px solid var(--red);padding-top:.5rem;margin:1.6rem 0 .6rem;clear:both}.legacy-recipe :global(h3){font-size:1.25rem;color:var(--blue);margin:1.2rem 0 .5rem}.legacy-recipe :global(p){margin:.6rem 0;max-width:78ch}.legacy-recipe :global(ul),.legacy-recipe :global(ol){padding-left:1.6rem;margin:.65rem 0 1rem}.legacy-recipe :global(ul){list-style:disc}.legacy-recipe :global(ol){list-style:decimal}.legacy-recipe :global(li){padding-left:.15rem;margin:.35rem 0}.legacy-recipe :global(li::marker){color:var(--red);font-weight:700}.legacy-recipe :global(a){color:var(--blue);text-decoration:underline;text-underline-offset:3px}.legacy-recipe :global(img){max-width:100%;height:auto;margin:.7rem 0}.legacy-recipe :global(img.right){float:right;max-width:38%;margin:0 0 1rem 1.5rem}.legacy-recipe :global(img.left){float:left;max-width:38%;margin:0 1.5rem 1rem 0}.legacy-recipe :global(.inline){display:block}.legacy-recipe :global(.foreign){font-style:italic}.legacy-recipe :global(.emph){font-weight:700}.legacy-recipe :global(hr){margin:1.3rem 0;border:0;border-top:2px solid var(--blue)}.legacy-recipe :global(table){width:100%;border-collapse:collapse}.legacy-recipe :global(td),.legacy-recipe :global(th){padding:.4rem;border-bottom:1px solid #bbb}.recipe-end{clear:both;border-top:6px solid var(--blue);margin-top:2rem;padding-top:1rem;color:var(--blue);font-weight:700}.recipe-page a:focus-visible{outline:3px solid var(--red);outline-offset:4px}@media(max-width:600px){.recipe-page{padding:1rem 1rem 2rem}.legacy-recipe{font-size:1rem}.legacy-recipe :global(img.right),.legacy-recipe :global(img.left){max-width:45%;margin:.3rem 0 1rem 1rem}.photo-strip img{height:110px}}@media print{.recipe-page{max-width:none;padding:0}.recipe-nav,.eyebrow,.tags,.recipe-end{display:none}.legacy-recipe{font-size:11pt}.legacy-recipe :global(h1){font-size:24pt}.legacy-recipe :global(h2){break-after:avoid;font-size:15pt}.legacy-recipe :global(img){max-height:180px;object-fit:contain}}
</style>
