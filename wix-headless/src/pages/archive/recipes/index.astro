---
import Layout from '../../../layouts/Layout.astro';
import recipes from '../../../data/archive-recipes.json';
const sorted = [...recipes].sort((a, b) => a.title.localeCompare(b.title));
const tags = [...new Set(recipes.flatMap(recipe => recipe.tags))].sort();
const tagLabel = (recipe: typeof recipes[number], tag: string) => `#${tag}${/^adaptable/i.test(recipe.dietaryNote || '') || new RegExp(`adapted to ${tag}`, 'i').test(recipe.dietaryNote || '') ? ' (adaptable)' : ''}`;
---
<Layout title="Recipes" description="Recipes from the phrits.com kitchen. Browse the collection or find something by name, ingredient, or tag.">
  <div class="recipe-index" data-recipe-index>
    <header class="index-heading">
      <div><a class="back" href="/archive">← The archive</a><p class="eyebrow">From the old kitchen</p><h1>Recipes</h1><p>Good food. A little instruction. A fair amount of opinion.</p></div>
      <img src="/archive-legacy/images/board_and_knife.jpg" alt="A knife and cutting board" width="420" height="260" />
    </header>
    <section class="finder" aria-label="Find a recipe">
      <label for="recipe-search">What are you hungry for?</label>
      <div class="search-row"><input id="recipe-search" type="search" placeholder="Search recipes or ingredients" autocomplete="off" aria-controls="recipe-results" /><button type="button" data-reset>Reset</button></div>
      <div class="tag-filters" role="group" aria-label="Filter by original recipe tags">
        <button type="button" data-tag="" aria-pressed="true">Everything</button>
        {tags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">#{tag}</button>)}
      </div>
      <p class="result-count" data-count role="status" aria-live="polite">{sorted.length} recipes</p>
    </section>
    <div id="recipe-results" class="recipe-results">
      {sorted.map((recipe, index) => <article class="recipe-row" data-recipe-row data-tags={JSON.stringify(recipe.tags)} data-search={`${recipe.title} ${recipe.tags.join(' ')} ${recipe.html.replace(/<[^>]*>/g, ' ')}`.toLowerCase()}>
        <span class="recipe-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="recipe-copy"><h2><a href={`/archive/recipes/${recipe.slug}/`}>{recipe.title}<span class="arrow" aria-hidden="true">↗</span></a></h2>
        {recipe.tags.length > 0 && <p class="recipe-tags">{recipe.tags.map(tag => <a href={`?tag=${encodeURIComponent(tag)}`} data-inline-tag={tag}>{tagLabel(recipe, tag)}</a>)}</p>}
        {recipe.dietaryNote && <p class="dietary-note">{recipe.dietaryNote.replace(/\s+,/g, ',')}</p>}</div>
        {(recipe.indexImage || recipe.images[0]) && <img src={recipe.indexImage || recipe.images[0]} alt="" loading="lazy" width="112" height="76" />}
      </article>)}
    </div>
    <div class="empty" data-empty hidden><h2>No recipes found.</h2><p>Try another ingredient or clear the filters.</p><button type="button" data-reset>Show everything</button></div>
  </div>
</Layout>
<script>
  function initRecipes() {
    const root = document.querySelector<HTMLElement>('[data-recipe-index]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const search = root.querySelector<HTMLInputElement>('#recipe-search')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const rows = [...root.querySelectorAll<HTMLElement>('[data-recipe-row]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let tag = '';
    function apply(updateURL = true) {
      const terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const row of rows) {
        const tags: string[] = JSON.parse(row.dataset.tags || '[]');
        const show = (!tag || tags.includes(tag)) && terms.every(term => row.dataset.search?.includes(term));
        row.hidden = !show;
        if (show) visible++;
      }
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.tag === tag)));
      count.textContent = `${visible} ${visible === 1 ? 'recipe' : 'recipes'}${visible !== rows.length ? ` of ${rows.length}` : ''}`;
      empty.hidden = visible > 0;
      if (updateURL) {
        const url = new URL(window.location.href);
        search.value.trim() ? url.searchParams.set('q', search.value.trim()) : url.searchParams.delete('q');
        tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
        history.replaceState(history.state, '', url);
      }
    }
    function fromURL() {
      const params = new URLSearchParams(window.location.search);
      search.value = params.get('q') || '';
      tag = params.get('tag') || '';
      apply(false);
    }
    search.addEventListener('input', () => apply());
    buttons.forEach(button => button.addEventListener('click', () => { tag = button.dataset.tag || ''; apply(); }));
    root.querySelectorAll<HTMLAnchorElement>('[data-inline-tag]').forEach(link => link.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault(); tag = link.dataset.inlineTag || ''; apply();
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach(button => button.addEventListener('click', () => { search.value = ''; tag = ''; apply(); search.focus(); }));
    window.addEventListener('popstate', fromURL);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('popstate', fromURL), {once:true});
    fromURL();
  }
  document.addEventListener('astro:page-load', initRecipes);
  initRecipes();
</script>
<style>
.recipe-index{--red:#9b0000;--blue:#08087a;--cream:#fff9eb;max-width:1080px;margin:auto;padding:1.5rem 1.5rem 4rem;color:#191919}.index-heading{display:grid;grid-template-columns:1fr minmax(180px,32%);gap:2rem;padding:1.5rem 0 1.8rem;border-bottom:10px solid var(--red);align-items:end}.back{color:var(--blue);font-weight:700;text-decoration:underline}.eyebrow{font-family:var(--font-mono);font-weight:700;text-transform:uppercase;margin:1.5rem 0 .35rem;font-size:.85rem;letter-spacing:.06em}h1{font-size:clamp(3.5rem,7vw,5.5rem);line-height:1;letter-spacing:-.04em;color:var(--blue);margin:0 0 .75rem}.index-heading img{width:100%;height:190px;object-fit:cover;border:8px solid var(--blue)}.finder{padding:1.4rem 0 1rem}.finder label{display:block;font-weight:700;font-size:1.15rem;margin-bottom:.5rem}.search-row{display:flex;gap:.5rem}.search-row input{min-width:0;flex:1;padding:.75rem 1rem;border:2px solid var(--blue);border-radius:0;background:white;color:#191919;font:inherit}button{font:inherit;font-weight:700;cursor:pointer;border:2px solid var(--blue);padding:.6rem .9rem;background:var(--cream);color:var(--blue);border-radius:0}button:hover,button[aria-pressed=true]{background:var(--blue);color:white}.tag-filters{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.8rem}.tag-filters button{font-family:var(--font-mono);font-size:.9rem;padding:.4rem .7rem}.result-count{font-size:.9rem;margin-top:.8rem}.recipe-results{border-top:4px solid var(--blue)}.recipe-row{display:flex;align-items:center;gap:1rem;border-bottom:1px solid #aca598;padding:.9rem .4rem;min-height:94px}.recipe-row[hidden],.empty[hidden]{display:none}.recipe-number{color:var(--red);font-family:var(--font-mono);font-size:.85rem;align-self:flex-start;padding-top:.3rem}.recipe-copy{flex:1;min-width:0}.recipe-copy h2{font-size:clamp(1.3rem,2.6vw,1.85rem);line-height:1.15;color:var(--blue)}.recipe-copy h2 a{text-decoration:none}.recipe-copy h2 a:hover{text-decoration:underline;text-underline-offset:4px}.arrow{font-size:1.1rem;margin-left:.6rem;color:var(--red);white-space:nowrap}.recipe-tags{display:flex;flex-wrap:wrap;gap:.3rem .8rem;margin-top:.4rem;font-family:var(--font-mono);font-size:.8rem;color:var(--red)}.recipe-tags a{text-decoration:underline;text-underline-offset:3px}.dietary-note{font-size:.8rem;margin-top:.25rem;color:#45413d}.recipe-row img{width:112px;height:76px;object-fit:cover}.empty{padding:2rem;border-left:8px solid var(--red);background:var(--cream)}.empty p{margin:.5rem 0 1rem}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #9b0000;outline-offset:4px}@media(max-width:600px){.recipe-index{padding:1rem 1rem 3rem}.index-heading{grid-template-columns:1fr;gap:1rem}.index-heading img{height:100px;object-position:center 55%}.eyebrow{margin-top:1rem}.recipe-row{gap:.6rem}.recipe-row img{width:75px;height:64px}.recipe-number{font-size:.75rem}.search-row button{padding:.5rem}.recipe-copy h2{font-size:1.35rem}}
</style>
