---
import Layout from '../layouts/Layout.astro';
import items from '../data/archive-items.json';
import recipes from '../data/archive-recipes.json';
const core = items.filter(i => !i.slug.startsWith('demeters-harvest/'));
const sections = [...new Set(core.map(i => i.section))];
---
<Layout title="Archive" description="Recipes, writing, and the earlier phrits.com.">
<header class="archive-heading"><div><p class="eyebrow">The earlier <span class="brand-inline">phrits.com</span></p><h1>Archive</h1><p>Food, writing, work, and a few other things collected along the way.</p></div></header>
<div class="archive-content">
<a class="kitchen" href="/archive/recipes/"><img src="/archive-legacy/images/board_and_knife.jpg" alt="A cutting board and kitchen knife"/><div><span class="eyebrow">Culinarian · {recipes.length} recipes</span><h2>From my kitchen</h2><p>Browse the recipes →</p></div></a>
<div class="sections">{sections.map(section => <section><h2>{section}</h2><ul>{core.filter(i => i.section === section).map(i => <li><a href={`/archive/item/?slug=${encodeURIComponent(i.slug)}`}>{i.title}<span aria-hidden="true"> →</span></a></li>)}</ul></section>)}<section><h2>Demeter’s Harvest (Archive)</h2><p>A W.A.R.D. Pagan/Wiccan cookbook collection, originally distributed on CD as a fundraiser. Read its historical context before browsing.</p><a class="cookbook" href="/archive/demeters-harvest/">Read about this collection →</a></section></div>
</div>
</Layout>
<style>
.archive-heading{background:#08087a;color:#fffdf7;border-right:clamp(1rem,12vw,12rem) solid #9b0000;border-bottom:6px solid #f2c53d;padding:2.5rem max(1.25rem,calc((100vw - 1120px)/2))}.archive-heading h1{font-size:clamp(3rem,8vw,6rem);margin:.6rem 0}.archive-content{max-width:1120px;margin:auto;padding:2rem 1.25rem 4rem}.kitchen{display:grid;grid-template-columns:1fr 1.3fr;background:#9b0000;color:#fffdf7}.kitchen img{width:100%;height:220px;object-fit:cover}.kitchen>div{padding:1.75rem}.kitchen h2{font-size:clamp(2rem,4vw,3.5rem);margin:.5rem 0 1rem}.sections{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:2rem}.sections section{border-top:7px solid #08087a;padding-top:1rem}.sections section:nth-child(even){border-color:#9b0000}.sections h2{font-size:1.8rem;margin-bottom:.8rem}.sections li{border-bottom:1px solid #cbbeac;padding:.5rem 0}.sections a:hover,.sections a:focus-visible{text-decoration:underline}.cookbook{display:inline-block;margin-top:.75rem;font-weight:bold;color:#08087a}@media(max-width:600px){.kitchen,.sections{grid-template-columns:1fr}.kitchen img{height:150px}.archive-heading{padding:1.5rem 1.25rem}}
</style>
